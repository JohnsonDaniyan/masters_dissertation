        {
          "name": "Front-channel authorize (after PAR_ENFORCED false)",
          "request": {
            "method": "GET",
            "header": [],
            "description": "Run Lab control → Patch toggle — PAR_ENFORCED false first. Then this issues a code without PAR.",
            "url": "{{baseUrl}}/authorize?client_id={{client_id}}&redirect_uri={{redirect_uri}}&scope={{scope}}&code_challenge={{code_challenge}}&code_challenge_method=S256"
          }
        }
      ]
    }
  ]
}
